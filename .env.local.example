# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API (or "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SECRET — server only. Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SECRET — server only. https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional. Defaults to the newest Gemini Flash model.
GEMINI_MODEL=gemini-flash-latest
# Optional. Used automatically when the main model is overloaded or slow.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Shown in the navbar and login page
NEXT_PUBLIC_COLLEGE_NAME=Your College
