# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API (or "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SECRET — server only. Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SECRET — server only. https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional. Primary model. Defaults to the newest Gemini Flash model. ("models/" prefix is stripped.)
GEMINI_MODEL=gemini-flash-latest
# Optional. Comma-separated, tried in order when the primary is rate-limited (429) or overloaded (503).
# Each model has its own free-tier quota, so listing 2-3 keeps the app working.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash-lite

# Shown in the navbar and login page
NEXT_PUBLIC_COLLEGE_NAME=Your College
